# Replace hostname and provide your site's trusted certificate configuration.
bitmesh.example.internal {
    tls /etc/bitmesh/https.crt /etc/bitmesh/https.key
    reverse_proxy 127.0.0.1:8000
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
}
