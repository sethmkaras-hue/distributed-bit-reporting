digraph BITMesh { rankdir=LR; node [shape=box style="rounded,filled" fillcolor="#e3eef8" fontname="Helvetica"]; GUI [label="React operator GUI\nREST + WebSocket"]; CPU [label="CPU\nDiscovery / archive / commands"]; DB [label="PostgreSQL\nSQLite development" shape=cylinder]; Master [label="Elected SOM master\nQuorum lease / aggregation"]; Peers [label="4–16 peer agents\nBIT / volatile journal / adapters"]; GUI -> CPU; CPU -> DB; CPU -> Master [label="CPU initiated gRPC"]; Master -> Peers [dir=both label="mTLS peer RPC"]; }
